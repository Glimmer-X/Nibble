# This checkout's own settings (local.env.example shows what goes in)
local.env

# Notes, design pages and history kept on this Mac only
internal/

# Build products (scripts/clean.sh removes them)
build/
.build/

# Generated by XcodeGen (scripts/build.sh regenerates it)
Nibble.xcodeproj/
*.xcworkspace/
xcuserdata/

# Created when Xcode opens the package
.swiftpm/

# Python bytecode (scripts)
__pycache__/

# macOS and editors
.DS_Store
._*
.vscode/
.idea/
*.swp

# Recordings for marketing (scripts/demo.sh remakes them)
marketing/*.mp4
marketing/*.mov
marketing/*.marks
