# Copy to local.env (git-ignored) to set up this checkout; scripts/env.sh reads it.

# Apple Developer team that signs builds (Xcode > Settings > Accounts). Leave it out to sign ad hoc.
NIBBLE_TEAM=

# For scripts/release.sh: a notarytool keychain profile (xcrun notarytool store-credentials).
NIBBLE_NOTARY_PROFILE=
